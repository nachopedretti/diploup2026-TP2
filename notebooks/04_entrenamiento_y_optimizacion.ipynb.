    {
      "cell_type": "markdown",
      "source": [
        "Probar distintas proporciones para comprobar si podemos mejorar la generalización."
      ],
      "metadata": {
        "id": "9cfIWGgH8n6R"
      },
      "id": "9cfIWGgH8n6R"
    },
    {
      "cell_type": "code",
      "source": [
        "valores_features = [\"sqrt\", \"log2\", 0.3, 0.5, 0.8, 1.0]\n",
        "\n",
        "resultados_features = []\n",
        "\n",
        "for features in valores_features:\n",
        "\n",
        "    modelo_rf = RandomForestClassifier(\n",
        "        n_estimators=100,\n",
        "        max_depth=10,\n",
        "        min_samples_leaf=5,\n",
        "        min_samples_split=2,\n",
        "        max_features=features,\n",
        "        random_state=42,\n",
        "        n_jobs=-1)\n",
        "\n",
        "    modelo_rf.fit(X_entrenamiento, y_entrenamiento)\n",
        "\n",
        "    pred_train = modelo_rf.predict(X_entrenamiento)\n",
        "    pred_val = modelo_rf.predict(X_validacion)\n",
        "\n",
        "    f1_train = f1_score(y_entrenamiento, pred_train)\n",
        "    f1_val = f1_score(y_validacion, pred_val)\n",
        "\n",
        "    resultados_features.append({\n",
        "        \"max_features\": features,\n",
        "        \"F1 Train\": f1_train,\n",
        "        \"F1 Validación\": f1_val,\n",
        "        \"Diferencia\": f1_train - f1_val})\n",
        "\n",
        "df_features = pd.DataFrame(resultados_features)\n",
        "\n",
        "display(df_features.round(4))"
      ],
