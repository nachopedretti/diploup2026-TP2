    {
      "cell_type": "code",
      "source": [
        "valores_C = [0.001, 0.01, 0.1, 1, 10, 100]\n",
        "\n",
        "resultados_logistica = []\n",
        "\n",
        "for c in valores_C:\n",
        "\n",
        "    modelo_logistico = LogisticRegression(\n",
        "        C=c,\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    modelo_logistico.fit(X_entrenamiento, y_entrenamiento)\n",
        "\n",
        "    pred_train = modelo_logistico.predict(X_entrenamiento)\n",
        "    pred_val = modelo_logistico.predict(X_validacion)\n",
        "\n",
        "    f1_train = f1_score(y_entrenamiento, pred_train)\n",
        "    f1_val = f1_score(y_validacion, pred_val)\n",
        "\n",
        "    resultados_logistica.append({\n",
        "        \"C\": c,\n",
        "        \"F1 Train\": f1_train,\n",
        "        \"F1 Validación\": f1_val,\n",
        "        \"Diferencia\": f1_train - f1_val\n",
        "    })\n",
        "\n",
        "df_logistica = pd.DataFrame(resultados_logistica)\n",
        "\n",
        "display(df_logistica.round(4))"
