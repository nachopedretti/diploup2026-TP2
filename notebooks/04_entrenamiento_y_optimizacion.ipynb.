        "# Variables con posibles valores extremos identificados en el EDA\n",
        "variables_extremas = [\"Gtp\", \"triglyceride\"]\n",
        "\n",
        "# Copias para no modificar los datos originales\n",
        "X_train_limitado = X_entrenamiento.copy()\n",
        "X_val_limitado = X_validacion.copy()\n",
        "\n",
        "# Calcular los límites usando solamente Train\n",
        "for variable in variables_extremas:\n",
        "    limite = X_entrenamiento[variable].quantile(0.99)\n",
        "\n",
        "    X_train_limitado[variable] = X_train_limitado[variable].clip(upper=limite)\n",
        "    X_val_limitado[variable] = X_val_limitado[variable].clip(upper=limite)\n",
        "\n",
        "# Entrenar el modelo con los valores limitados\n",
        "modelo_limitado = LogisticRegression(\n",
        "    C=0.1,\n",
        "    class_weight=\"balanced\",\n",
        "    max_iter=1000,\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "modelo_limitado.fit(X_train_limitado, y_entrenamiento)\n",
        "\n",
        "# Predicciones sobre Validación\n",
        "probabilidades = modelo_limitado.predict_proba(X_val_limitado)[:, 1]\n",
        "predicciones = (probabilidades >= 0.55).astype(int)\n",
        "\n",
        "# Comparar con el modelo original\n",
        "comparacion_extremos = pd.DataFrame([\n",
