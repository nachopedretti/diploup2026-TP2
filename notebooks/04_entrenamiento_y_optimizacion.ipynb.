        "        class_weight=\"balanced\",\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    modelo.fit(X_entrenamiento[columnas], y_entrenamiento)\n",
        "\n",
        "    probabilidades = modelo.predict_proba(\n",
