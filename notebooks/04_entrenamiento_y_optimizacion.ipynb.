        "## División de Train en entrenamiento y validación"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 8,
      "id": "5726c281",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "5726c281",
        "outputId": "ca999b86-d49b-400b-ba7e-35e72b3b3d9d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Entrenamiento: (28000, 24)\n",
            "Validación: (12000, 24)\n"
          ]
        }
      ],
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "X_entrenamiento, X_validacion, y_entrenamiento, y_validacion = train_test_split(\n",
        "    X_train,\n",
        "    y_train,\n",
        "    test_size=0.30,\n",
        "    random_state=42,\n",
        "    stratify=y_train\n",
        ")\n",
        "\n",
        "print(\"Entrenamiento:\", X_entrenamiento.shape)\n",
        "print(\"Validación:\", X_validacion.shape)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.tree import DecisionTreeClassifier\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import f1_score\n",
        "\n",
        "# Modelos iniciales\n",
        "modelos = {\n",
        "    \"Regresión Logística\": LogisticRegression(\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    ),\n",
        "    \"Árbol de Decisión\": DecisionTreeClassifier(\n",
        "        random_state=42\n",
        "    ),\n",
        "    \"Random Forest\": RandomForestClassifier(\n",
        "        random_state=42,\n",
        "        n_jobs=-1)}\n",
        "\n",
        "# Entrenamiento y evaluación\n",
        "resultados = []\n",
        "\n",
        "for nombre, modelo in modelos.items():\n",
        "\n",
        "    modelo.fit(X_entrenamiento, y_entrenamiento)\n",
        "\n",
        "    pred_train = modelo.predict(X_entrenamiento)\n",
        "    pred_val = modelo.predict(X_validacion)\n",
        "\n",
        "    f1_train = f1_score(y_entrenamiento, pred_train)\n",
        "    f1_val = f1_score(y_validacion, pred_val)\n",
        "\n",
        "    resultados.append({\n",
        "        \"Modelo\": nombre,\n",
        "        \"F1 Train\": f1_train,\n",
        "        \"F1 Validación\": f1_val,\n",
        "        \"Diferencia\": f1_train - f1_val\n",
        "    })\n",
        "\n",
        "df_resultados = pd.DataFrame(resultados)\n",
        "\n",
        "display(df_resultados.round(4))"
      ],
