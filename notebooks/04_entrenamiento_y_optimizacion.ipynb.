        "# Estabilidad de Regresión Logística balanceada\n",
        "# con umbral de clasificación 0.55\n",
        "\n",
        "semillas = [10, 21, 42, 55, 100]\n",
        "\n",
        "resultados_estabilidad_log = []\n",
        "\n",
        "for semilla in semillas:\n",
        "\n",
        "    X_ent, X_val, y_ent, y_val = train_test_split(\n",
        "        X_train,\n",
        "        y_train,\n",
        "        test_size=0.30,\n",
        "        random_state=semilla,\n",
        "        stratify=y_train\n",
        "    )\n",
        "\n",
        "    modelo = LogisticRegression(\n",
        "        C=0.1,\n",
        "        class_weight=\"balanced\",\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    modelo.fit(X_ent, y_ent)\n",
        "\n",
        "    prob_ent = modelo.predict_proba(X_ent)[:, 1]\n",
        "    prob_val = modelo.predict_proba(X_val)[:, 1]\n",
        "\n",
        "    pred_ent = (prob_ent >= 0.55).astype(int)\n",
        "    pred_val = (prob_val >= 0.55).astype(int)\n",
        "\n",
        "    f1_ent = f1_score(y_ent, pred_ent)\n",
        "    f1_val = f1_score(y_val, pred_val)\n",
        "\n",
        "    resultados_estabilidad_log.append({\n",
        "        \"Semilla\": semilla,\n",
        "        \"F1 Train\": f1_ent,\n",
        "        \"F1 Validación\": f1_val,\n",
        "        \"Diferencia\": f1_ent - f1_val\n",
