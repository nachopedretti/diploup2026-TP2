      "source": [
        "# Variables que vamos a quitar\n",
        "variables_a_eliminar = [\n",
        "    \"waist(cm)\",\n",
        "    \"relaxation\",\n",
        "    \"LDL\",\n",
        "    \"ALT\"]\n",
        "\n",
        "# Preparar las dos configuraciones\n",
        "configuraciones = {\n",
        "    \"Todas las variables\": X_entrenamiento.columns.tolist(),\n",
