      "source": [
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.metrics import f1_score, precision_score, recall_score\n",
        "\n",
        "# Comparar con todas las variables y sin cintura\n",
        "resultados_comparacion = []\n",
        "\n",
        "for nombre, columnas in [\n",
        "    (\"Todas las variables\", X_entrenamiento.columns.tolist()),\n",
        "    (\"Sin cintura\", X_entrenamiento.drop(columns=[\"waist(cm)\"]).columns.tolist())\n",
        "]:\n",
        "    modelo = LogisticRegression(\n",
        "        C=0.1,\n",
        "        class_weight=\"balanced\",\n",
        "        max_iter=1000,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    modelo.fit(X_entrenamiento[columnas], y_entrenamiento)\n",
        "\n",
        "    probabilidades = modelo.predict_proba(X_validacion[columnas])[:, 1]\n",
        "    predicciones = (probabilidades >= 0.55).astype(int)\n",
        "\n",
        "    resultados_comparacion.append({\n",
        "        \"Configuración\": nombre,\n",
        "        \"Variables\": len(columnas),\n",
        "        \"Precision\": precision_score(y_validacion, predicciones),\n",
        "        \"Recall\": recall_score(y_validacion, predicciones),\n",
        "        \"F1-score\": f1_score(y_validacion, predicciones)\n",
        "    })\n",
        "\n",
        "pd.DataFrame(resultados_comparacion).round(4)"
      ],
